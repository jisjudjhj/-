# Same-origin deployment through Nginx:
#   /              -> management-pc dist
#   /ecommerce-api -> backend http://127.0.0.1:8081/api
#   /ecommerce-ws  -> backend http://127.0.0.1:8081/ws
VITE_PUBLIC_BASE=/
VITE_API_BASE=/ecommerce-api
VITE_WS_BASE=/ecommerce-ws
VITE_COMPETITION_MODE=true

# If the frontend and backend are deployed on different hosts, use absolute URLs instead:
# VITE_PUBLIC_BASE=/
# VITE_API_BASE=http://YOUR_SERVER_IP:8081/api
# VITE_WS_BASE=http://YOUR_SERVER_IP:8081/ws
