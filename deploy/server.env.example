# Host nginx will proxy:
#   /        -> 127.0.0.1:8088
#   /api     -> 127.0.0.1:8080/api
#   /ws      -> 127.0.0.1:8080/ws
#   /uploads -> 127.0.0.1:8080/uploads

SERVER_IP=example.com

# Docker compose deployment variables
DB_NAME=ecommerce_recommend
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Backend runtime flags
MQ_ENABLED=false
STREAM_REALTIME_ENABLED=true
STREAM_KAFKA_ENABLED=false
JAVA_OPTS=-Xms256m -Xmx768m
LOCAL_BASE_URL=https://example.com/uploads
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
AI_API_KEY=

# Optional OSS configuration
ALIYUN_OSS_ENDPOINT=oss-cn-your-region.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_URL_PREFIX=

# Optional RabbitMQ credentials
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
