-- Flink CDC 直连 MySQL：用户实时品类偏好
-- 运行前请确保：
-- 1) 本机 Flink 已启动
-- 2) FLINK_HOME/lib 中已放入：
--    - Flink CDC MySQL connector
--    - Flink JDBC connector
--    - MySQL JDBC driver
-- 3) MySQL 已开启 binlog（ROW 模式）

SET 'execution.runtime-mode' = 'streaming';
SET 'table.local-time-zone' = 'Asia/Shanghai';

CREATE TABLE user_behavior_cdc (
  id BIGINT,
  user_id BIGINT,
  product_id BIGINT,
  behavior_type STRING,
  search_keyword STRING,
  duration INT,
  create_time TIMESTAMP(3),
  proc_time AS PROCTIME(),
  PRIMARY KEY (id) NOT ENFORCED
) WITH (
  'connector' = 'mysql-cdc',
  'hostname' = '__MYSQL_HOST__',
  'port' = '__MYSQL_PORT__',
  'username' = '__MYSQL_USERNAME__',
  'password' = '__MYSQL_PASSWORD__',
  'database-name' = '__MYSQL_DATABASE__',
  'table-name' = 'user_behavior'
);

CREATE TABLE product_dim (
  id BIGINT,
  category_id BIGINT,
  status INT,
  PRIMARY KEY (id) NOT ENFORCED
) WITH (
  'connector' = 'jdbc',
  'url' = 'jdbc:mysql://__MYSQL_HOST__:__MYSQL_PORT__/__MYSQL_DATABASE__?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai',
  'table-name' = 'product',
  'username' = '__MYSQL_USERNAME__',
  'password' = '__MYSQL_PASSWORD__'
);

CREATE TABLE category_dim (
  id BIGINT,
  name STRING,
  PRIMARY KEY (id) NOT ENFORCED
) WITH (
  'connector' = 'jdbc',
  'url' = 'jdbc:mysql://__MYSQL_HOST__:__MYSQL_PORT__/__MYSQL_DATABASE__?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai',
  'table-name' = 'category',
  'username' = '__MYSQL_USERNAME__',
  'password' = '__MYSQL_PASSWORD__'
);

CREATE TABLE stream_user_category_preference (
  user_id BIGINT,
  category_id BIGINT,
  category_name STRING,
  preference_score DOUBLE,
  behavior_count BIGINT,
  last_event_time TIMESTAMP(3),
  update_time TIMESTAMP(3),
  PRIMARY KEY (user_id, category_id) NOT ENFORCED
) WITH (
  'connector' = 'jdbc',
  'url' = 'jdbc:mysql://__MYSQL_HOST__:__MYSQL_PORT__/__MYSQL_DATABASE__?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai',
  'table-name' = 'stream_user_category_preference',
  'username' = '__MYSQL_USERNAME__',
  'password' = '__MYSQL_PASSWORD__'
);

INSERT INTO stream_user_category_preference
SELECT
  ub.user_id,
  pd.category_id,
  COALESCE(cd.name, CONCAT('分类-', CAST(pd.category_id AS STRING))) AS category_name,
  CAST(SUM(
    CASE ub.behavior_type
      WHEN 'purchase' THEN 5.0
      WHEN 'favorite' THEN 3.0
      WHEN 'cart' THEN 2.0
      WHEN 'view' THEN 1.0
      ELSE 0.5
    END
  ) AS DOUBLE) AS preference_score,
  COUNT(*) AS behavior_count,
  MAX(ub.create_time) AS last_event_time,
  CURRENT_TIMESTAMP AS update_time
FROM user_behavior_cdc AS ub
LEFT JOIN product_dim FOR SYSTEM_TIME AS OF ub.proc_time AS pd
  ON ub.product_id = pd.id
LEFT JOIN category_dim FOR SYSTEM_TIME AS OF ub.proc_time AS cd
  ON pd.category_id = cd.id
WHERE ub.user_id IS NOT NULL
  AND ub.product_id IS NOT NULL
  AND pd.category_id IS NOT NULL
  AND (pd.status IS NULL OR pd.status = 1)
GROUP BY ub.user_id, pd.category_id, cd.name;
