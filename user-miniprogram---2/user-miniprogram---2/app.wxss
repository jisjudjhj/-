  --shadow-glow: 0 14rpx 28rpx rgba(0, 122, 255, 0.09);
}

page {
  --page-shell-bg:
    radial-gradient(circle at 88% -12%, rgba(0, 122, 255, 0.08), transparent 34%),
    linear-gradient(180deg, #fafafb 0%, #f4f5f7 48%, #f1f2f4 100%);
  --panel-bg: rgba(255, 255, 255, 0.98);
  --panel-border: rgba(17, 17, 17, 0.06);
