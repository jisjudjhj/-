  --accent-strong: #ff244b;
  --background-color: #f5f5f7;
  --surface-color: rgba(255, 255, 255, 0.98);
  --surface-soft: #f3f4f6;
  --surface-muted: #eceef2;
  --text-primary: #111111;
  --text-secondary: #636774;
  --text-tertiary: #9499a8;
  --text-placeholder: #b3b8c4;
  --border-color: rgba(17, 17, 17, 0.08);
  --border-light: rgba(17, 17, 17, 0.05);
