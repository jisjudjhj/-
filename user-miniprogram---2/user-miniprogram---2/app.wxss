  border: 1rpx solid var(--border-color) !important;
  border-radius: var(--radius-lg) !important;
  box-shadow: var(--shadow-sm) !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

.surface-list {
  overflow: hidden;
  background: var(--surface-color);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-lg);
}

.surface-list-row {
  min-height: 96rpx;
  padding: 0 var(--spacing-md);
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--border-light);
}

.surface-list-row:last-child {
  border-bottom: 0;
}

.status-pill {
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-round);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  background: var(--surface-soft);
  color: var(--text-secondary);
}

.status-pill-info {
  background: var(--accent-soft);
  color: var(--accent-color);
}

.status-pill-success {
  background: rgba(52, 199, 89, 0.12);
  color: var(--success-color);
}

.status-pill-warning {
  background: rgba(255, 149, 0, 0.12);
  color: var(--warning-color);
}

.status-pill-danger {
  background: rgba(255, 59, 48, 0.1);
  color: var(--danger-color);
}

.bottom-action-bar,
.fixed-bottom,
.checkout-footer,
.cart-footer,
.detail-action-bar {
  background: rgba(255, 255, 255, 0.96) !important;
  border-top: 1rpx solid var(--border-color) !important;
  box-shadow: none !important;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.btn-primary-gradient,
.primary-btn,
.submit-btn,
.pay-btn,
.checkout-btn,
.send-btn {
  background: var(--accent-color) !important;
  color: #FFFFFF !important;
  border-color: var(--accent-color) !important;
  box-shadow: none !important;
}

button:active,
.active-opacity:active,
.hover-scale:active,
.ios-card-clickable:active {
  opacity: 0.86;
  transform: scale(0.98);
  transition: opacity 0.16s ease, transform 0.16s ease;
}

/* ===== Mini program closure polish: white, quiet, no extra decoration ===== */
page {
  --accent-color: #007AFF;
  --accent-soft: rgba(0, 122, 255, 0.1);
  --background-color: #F5F5F7;
  --surface-color: #FFFFFF;
  --surface-soft: #F7F8FA;
  --panel-bg: #FFFFFF;
  --panel-border: rgba(60, 60, 67, 0.1);
  --panel-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.035);
  background: var(--background-color) !important;
}

.bg-gradient-primary,
.page-shell,
.home-page,
.container,
.conversion-page,
.profile-page,
.pay-page {
  background: var(--background-color) !important;
}

.glass-glow-sky,
.glass-glow-rose,
.glass-overlay-top,
.profile-atmosphere,
.profile-grid-mask,
.tab-bar-ambient {
  display: none !important;
}

.glass-card,
.glass-card-soft,
.card-elevated,
.card-elevated-strong,
.surface-panel,
.surface-panel-strong,
.section,
.main-panel,
.feed-zone,
.cart-hero,
.cart-item,
.profile-hero,
.wallet-card,
.user-stats-bar,
.service-section,
.order-section,
.pay-page .section {
  background: #FFFFFF !important;
  border: 1rpx solid var(--panel-border) !important;
  box-shadow: var(--panel-shadow) !important;
}

.badge-rose {
  background: var(--accent-soft) !important;
  border-color: rgba(0, 122, 255, 0.16) !important;
  color: var(--accent-color) !important;
  box-shadow: none !important;
  letter-spacing: 0 !important;
}

.btn-primary-gradient,
.wallet-btn,
.hero-action {
  background: var(--accent-color) !important;
  color: #FFFFFF !important;
  box-shadow: none !important;
  letter-spacing: 0 !important;
}

/* ===== Global readability pass for high-density phones ===== */
.section-title,
.zone-title,
.text-heading,
.page-title,
.panel-title,
.card-title,
.order-title,
.goods-title,
.product-title,
.service-name,
.cell-title {
  font-size: 31rpx !important;
  line-height: 1.28 !important;
  font-weight: 700 !important;
}

.text-description,
.section-more,
.cell-desc,
.meta-text,
.goods-meta,
.order-meta,
.price-label,
.status-text,
.empty-desc {
  font-size: 24rpx !important;
  line-height: 1.48 !important;
}

.badge,
.badge-rose,
.tag,
.status-tag,
.section-badge,
.coupon-tag,
.warning-tag {
  min-height: 40rpx !important;
  padding-left: 14rpx !important;
  padding-right: 14rpx !important;
  font-size: 21rpx !important;
  line-height: 40rpx !important;
}

.arrow-right,
.arrow-right-small {
  width: 18rpx !important;
  height: 18rpx !important;
  border-width: 3rpx 3rpx 0 0 !important;
}

.empty-title {
  font-size: 30rpx !important;
}

.empty-icon {
  width: 128rpx !important;
  height: 128rpx !important;
}

/* Project-wide cardless pass: keep structure, remove floating card treatment. */
.glass-card,
.glass-card-soft,
.card-elevated,
.card-elevated-strong,
.surface-panel,
.surface-panel-strong,
.section,
.main-panel,
.feed-zone,
.cart-hero,
.cart-item,
.profile-hero,
.wallet-card,
.user-stats-bar,
.service-section,
.order-section,
.pay-page .section {
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

.section,
.main-panel,
.cart-item,
.service-section,
.order-section {
  border-bottom: 1rpx solid var(--border-light) !important;
}

