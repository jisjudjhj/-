page {
  --primary-color: #111827;
  --secondary-color: #f4f6fb;
  --accent-color: #007AFF;
  --accent-soft: #fff1f5;
  --accent-strong: #007AFF;
  --background-color: #fbfbfc;
  --surface-color: rgba(255, 255, 255, 0.96);
  --surface-soft: #f5f7fb;
  --surface-muted: #eef2f7;
  --surface-glass: rgba(255, 255, 255, 0.74);

  --text-primary: #111827;
  --text-secondary: #4b5563;
  --text-tertiary: #6b7280;
  --text-placeholder: #9ca3af;

  --border-color: rgba(17, 24, 39, 0.08);
  --border-light: rgba(17, 24, 39, 0.06);
  --border-strong: rgba(17, 24, 39, 0.12);

  --glass-bg: rgba(255, 255, 255, 0.82);
  --glass-bg-dark: rgba(18, 20, 28, 0.84);
  --glass-border: rgba(255, 255, 255, 0.52);

  --danger-color: #ff3b30;
  --warning-color: #ff9f0a;
  --success-color: #22c55e;

  --spacing-xs: 10rpx;
  --spacing-sm: 18rpx;
  --spacing-md: 28rpx;
  --spacing-lg: 40rpx;
  --spacing-xl: 56rpx;
  --spacing-xxl: 76rpx;
  --spacing-3xl: 112rpx;

  --radius-sm: 20rpx;
  --radius-md: 28rpx;
  --radius-lg: 36rpx;
  --radius-xl: 48rpx;
  --radius-round: 999rpx;

  --shadow-sm: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
  --shadow-md: 0 18rpx 36rpx rgba(15, 23, 42, 0.08);
  --shadow-lg: 0 30rpx 60rpx rgba(15, 23, 42, 0.1);
  --shadow-glow: 0 18rpx 44rpx rgba(0, 122, 255, 0.12);
  --content-max-width: 100%;

  --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "微软雅黑", "Helvetica Neue", Helvetica, Arial, sans-serif;

  font-family: var(--font-family);
  background:
    radial-gradient(circle at 12% 8%, rgba(0, 122, 255, 0.12), transparent 28%),
    radial-gradient(circle at 88% 10%, rgba(17, 24, 39, 0.12), transparent 30%),
    linear-gradient(180deg, #fbfbfc 0%, #f4f5f7 100%);
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

view, text, scroll-view, swiper, button, form, input, textarea, label, navigator, image {
  box-sizing: border-box;
}

::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
  display: none;
}

.page-bottom-spacer {
  width: 100%;
  height: calc(var(--bottom-safe-reserve, 160rpx) + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.page-bottom-spacer--home {
  --bottom-safe-reserve: 188rpx;
}

.page-bottom-spacer--detail {
  --bottom-safe-reserve: 296rpx;
}

.page-bottom-spacer--cart {
  --bottom-safe-reserve: 410rpx;
}

.page-bottom-spacer--form {
  --bottom-safe-reserve: 180rpx;
}

.page-bottom-spacer--small {
  --bottom-safe-reserve: 60rpx;
}

.bottom-safe-area {
  padding-bottom: calc(var(--bottom-safe-padding, 16rpx) + env(safe-area-inset-bottom));
}

.fixed-bottom-safe {
  bottom: 0;
  padding-bottom: calc(var(--bottom-safe-padding, 16rpx) + env(safe-area-inset-bottom));
}

.text-h1 {
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -1rpx;
}

.text-h2 {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.5rpx;
}

.text-h3 {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.3;
}

.text-body {
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.6;
}

.text-caption {
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.4;
  color: var(--text-secondary);
}

.text-center { text-align: center; }
.text-right { text-align: right; }
.flex-row { display: flex; flex-direction: row; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.align-center { align-items: center; }
.justify-center { justify-content: center; }
.flex-1 { flex: 1; }
.flex-wrap { flex-wrap: wrap; }

.glass-panel {
  background: var(--glass-bg);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--shadow-md);
}

.glass-panel-dark {
  background: var(--glass-bg-dark);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #fff;
}

.glass-panel-light {
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border: 1rpx solid rgba(60, 60, 67, 0.1);
  color: var(--text-primary);
}

.text-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.img-responsive {
  width: 100%;
  height: auto;
  display: block;
}

.img-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.transition-all {
  transition: all 0.38s cubic-bezier(0.22, 1, 0.36, 1);
}

.hover-scale {
  transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.24s ease;
}

.hover-scale:active {
  transform: scale(0.98) translateY(1rpx);
}

.active-opacity:active {
  opacity: 0.84;
  transition: opacity 0.14s ease;
}

@keyframes shimmer {
  0% { background-position: -1000px 0; }
  100% { background-position: 1000px 0; }
}

.skeleton-bg {
  background: #f0f1f4;
  background-image: linear-gradient(90deg, #f0f1f4 0px, #f7f7f9 180px, #f0f1f4 360px);
  background-size: 1000px 100%;
  animation: shimmer 2s infinite linear forwards;
}

.image-placeholder {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(0, 122, 255, 0.08) 0%, rgba(255, 255, 255, 0) 42%),
    linear-gradient(315deg, rgba(0, 122, 255, 0.08) 0%, rgba(255, 255, 255, 0) 40%),
    #f6f7fb;
}

.image-placeholder::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 24% 24%, rgba(255, 255, 255, 0.68), rgba(255, 255, 255, 0) 32%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(22, 24, 35, 0.02));
}

.image-placeholder-text {
  position: relative;
  z-index: 1;
  padding: 0 12rpx;
  text-align: center;
  color: #8a93a3;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.45;
}

page {
  --page-shell-bg:
    radial-gradient(circle at 88% -10%, rgba(0, 122, 255, 0.08), transparent 34%),
    radial-gradient(circle at 8% 10%, rgba(86, 138, 255, 0.08), transparent 24%),
    linear-gradient(180deg, #fbfcff 0%, #f6f7fb 52%, #f3f5f9 100%);
  --panel-bg: rgba(255, 255, 255, 0.94);
  --panel-border: rgba(22, 24, 35, 0.06);
  --panel-shadow: 0 18rpx 44rpx rgba(22, 24, 35, 0.05);
  --panel-shadow-strong: 0 28rpx 66rpx rgba(22, 24, 35, 0.07);
  --muted-chip-bg: rgba(22, 24, 35, 0.05);
  --muted-chip-text: #6f7686;
}

.page-shell {
  position: relative;
  min-height: 100vh;
  background: var(--page-shell-bg);
}

.surface-panel {
  background: var(--panel-bg);
  border: 1rpx solid var(--panel-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--panel-shadow);
}

.surface-panel-strong {
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(22, 24, 35, 0.06);
  border-radius: var(--radius-lg);
  box-shadow: var(--panel-shadow-strong);
}

.section-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.page-gutter {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.ios-raise {
  animation: iosRaiseIn 380ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes iosRaiseIn {
  from {
    opacity: 0;
    transform: translate3d(0, 18rpx, 0) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

/* Unified commerce direction */
page {
