}


/* ===== PC Login Style - Glass Morphism ===== */
.glass-card {
  background: rgba(255, 255, 255, 0.74);
  backdrop-filter: blur(36rpx);
  -webkit-backdrop-filter: blur(36rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: var(--radius-xl);
  box-shadow: 0 30rpx 90rpx rgba(15, 23, 42, 0.14);
}

.glass-card-soft {
  background: rgba(255, 255, 255, 0.62);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  border-radius: var(--radius-lg);
  box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.1);
}

.glass-overlay-top {
  position: absolute;
  inset: 0 0 auto 0;
  height: 200rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.7) 0%, transparent 100%);
  pointer-events: none;
}

.glass-glow-sky {
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(125, 211, 252, 0.1);
  filter: blur(60rpx);
  pointer-events: none;
}

.glass-glow-rose {
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(0, 122, 255, 0.1);
  filter: blur(60rpx);
  pointer-events: none;
}

/* ===== PC Login Style - Buttons ===== */
.btn-primary-gradient {
  background: linear-gradient(135deg, #111827 0%, #2a303b 54%, #007AFF 100%);
  box-shadow: 0 18rpx 36rpx rgba(17, 24, 39, 0.2);
  border: none;
  color: #ffffff;
  font-weight: 600;
  letter-spacing: 0.2em;
  transition: all 0.3s ease;
}

.btn-primary-gradient:active {
  background: linear-gradient(135deg, #000000 0%, #252a34 52%, #007AFF 100%);
  box-shadow: 0 24rpx 44rpx rgba(17, 24, 39, 0.26);
  transform: translateY(-2rpx);
}

/* ===== PC Login Style - Inputs ===== */
.input-glass {
  background: rgba(255, 255, 255, 0.62);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
  transition: all 0.18s ease;
}

.input-glass:focus {
  border-color: rgba(0, 122, 255, 0.5);
  box-shadow: 0 0 0 6rpx rgba(0, 122, 255, 0.1), 0 18rpx 36rpx rgba(17, 24, 39, 0.12);
  transform: translateY(-2rpx);
}

/* ===== PC Login Style - Cards ===== */
.card-elevated {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(17, 24, 39, 0.08);
  border-radius: var(--radius-lg);
  box-shadow: 0 18rpx 36rpx rgba(15, 23, 42, 0.08);
}

.card-elevated-strong {
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(17, 24, 39, 0.08);
  border-radius: var(--radius-xl);
  box-shadow: 0 30rpx 60rpx rgba(15, 23, 42, 0.1);
}

/* ===== PC Login Style - Badges ===== */
.badge-rose {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-round);
  border: 1rpx solid rgba(0, 122, 255, 0.2);
  background: rgba(255, 255, 255, 0.6);
  color: #007AFF;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.22em;
  box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.12);
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #007AFF;
}

/* ===== PC Login Style - Dividers ===== */
.divider-gradient {
  height: 2rpx;
  width: 160rpx;
  background: linear-gradient(90deg, transparent 0%, rgba(0, 122, 255, 0.8) 50%, transparent 100%);
}

/* ===== PC Login Style - Text Styles ===== */
.text-brand {
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--text-primary);
}

.text-subtitle {
  font-size: 22rpx;
  letter-spacing: 0.38em;
  color: var(--text-tertiary);
  text-transform: uppercase;
}

.text-heading {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.24em;
  color: var(--text-primary);
}

.text-description {
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--text-secondary);
}

/* ===== PC Login Style - Animations ===== */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.animate-float {
  animation: float 3s ease-in-out infinite;
}

@keyframes pulse-glow {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 0.8; }
}

.animate-pulse-glow {
  animation: pulse-glow 2s ease-in-out infinite;
}

/* ===== PC Login Style - Backgrounds ===== */
.bg-gradient-primary {
  background:
    radial-gradient(circle at 12% 8%, rgba(0, 122, 255, 0.12), transparent 28%),
    radial-gradient(circle at 88% 10%, rgba(17, 24, 39, 0.12), transparent 30%),
    linear-gradient(180deg, #fbfbfc 0%, #f4f5f7 100%);
}

.bg-gradient-soft {
  background:
    radial-gradient(circle at 20% 20%, rgba(0, 122, 255, 0.08), transparent 32%),
    linear-gradient(180deg, #ffffff 0%, #f8f9fb 100%);
}

/* ===== Enhanced Shadows ===== */
.shadow-elevated {
  box-shadow: 0 18rpx 36rpx rgba(15, 23, 42, 0.08);
}

.shadow-elevated-strong {
  box-shadow: 0 30rpx 60rpx rgba(15, 23, 42, 0.1);
}

.shadow-glow-rose {
  box-shadow: 0 18rpx 44rpx rgba(0, 122, 255, 0.12);
}

.shadow-glow-primary {
  box-shadow: 0 18rpx 36rpx rgba(17, 24, 39, 0.2);
}

