.container {
  min-height: 100vh;
  background: var(--page-shell-bg);
}

.fp-scroll {
  height: 100vh;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.clear-btn,
.empty-btn {
  border-radius: 999rpx;
}

.clear-btn {
  min-width: 118rpx;
  height: 52rpx;
  padding: 0 20rpx;
  background: #111111;
  color: #ffffff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
}

.hero,
.empty-state {
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(17, 17, 17, 0.06);
  box-shadow: 0 12rpx 28rpx rgba(17, 17, 17, 0.05);
}

.hero-kicker,
.date-kicker {
  color: #98a0ae;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-title,
.date-text,
.empty-text {
  color: #161823;
}

.hero-title {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 760;
  line-height: 1.35;
}

.hero-subtitle,
.date-count,
.empty-tip,
.load-more {
  color: #6b7080;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.62;
}

.hero-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.hero-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f5f7fb;
  border: 1rpx solid rgba(22, 24, 35, 0.04);
  color: #5f6b7c;
  font-size: 20rpx;
}

.date-header {
  margin-top: 18rpx;
  padding: 0 4rpx 12rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.date-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.date-text {
  font-size: 28rpx;
  font-weight: 760;
}

.date-count {
  font-size: 20rpx;
}

.fp-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.fp-record {
  min-height: 172rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(17, 17, 17, 0.06);
  display: flex;
  gap: 18rpx;
  box-sizing: border-box;
}

.fp-record-img {
  width: 136rpx;
  height: 136rpx;
  border-radius: 18rpx;
  background: #f5f6f8;
  flex: 0 0 auto;
}

.fp-record-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa1ad;
  font-size: 24rpx;
}

.fp-record-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.fp-record-title {
  color: #111111;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.38;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.fp-record-meta {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  color: #7b8290;
  font-size: 22rpx;
}

.fp-record-bottom {
  margin-top: auto;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.fp-record-price {
  color: #007aff;
  font-size: 32rpx;
  font-weight: 800;
}

.fp-record-time {
  color: #9aa1ad;
  font-size: 22rpx;
}

.fp-record-tail {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.fp-record-count {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #f5f7fb;
  color: #6b7080;
  font-size: 20rpx;
}

.empty-state {
  text-align: center;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto;
  border-radius: 40rpx;
  background: #f6f7fb;
}

.empty-text {
  margin-top: 28rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
}

.empty-btn {
  margin: 36rpx auto 0;
  width: 240rpx;
  height: 72rpx;
  background: #111111;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.load-more {
  text-align: center;
  padding: 24rpx 0 40rpx;
  font-size: 20rpx;
}

/* Readability pass */
.empty-text,
.product-name,
.item-title {
  font-size: 31rpx !important;
  line-height: 1.34 !important;
}

.empty-tip,
.load-more,
.product-meta,
.item-meta,
.product-tag {
  font-size: 24rpx !important;
  line-height: 1.5 !important;
}

.empty-btn,
.action-btn {
  min-height: 78rpx !important;
  font-size: 26rpx !important;
}
