.container {
  min-height: 100vh;
  background:
    radial-gradient(circle at 92% -8%, rgba(0, 122, 255, 0.08), transparent 34%),
    linear-gradient(180deg, #fbfcff 0%, #f6f7fb 48%, #f3f5f9 100%);
}

.about-scroll {
  height: calc(100vh - 88rpx);
  padding: 10rpx 28rpx 0;
  box-sizing: border-box;
}

.hero-card,
.info-card,
.story-card {
  margin-top: 18rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 48rpx rgba(19, 19, 19, 0.08);
}

.hero-card {
  padding: 44rpx 32rpx;
  text-align: center;
}

.logo-wrap {
  width: 150rpx;
  height: 150rpx;
  margin: 0 auto;
  border-radius: 42rpx;
  background: #111111;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-text {
  font-size: 70rpx;
  font-weight: 800;
  color: #ffffff;
}

.hero-title,
.story-title,
.info-value {
  color: #181818;
}

.hero-title {
  display: block;
  margin-top: 28rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.hero-version,
.info-label,
.footer-note,
.story-copy,
.hero-desc,
.story-kicker {
  color: #6f6759;
}

.hero-version {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
}

.hero-desc,
.story-copy {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.85;
}

.info-card {
  padding: 10rpx 28rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(18, 18, 18, 0.06);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label,
.info-value {
  font-size: 26rpx;
}

.info-value {
  font-weight: 700;
}

.story-card {
  padding: 34rpx 30rpx;
}

.story-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.story-title {
  display: block;
  margin-top: 16rpx;
  font-size: 36rpx;
  line-height: 1.42;
  font-weight: 800;
}

.footer-note {
  margin-top: 32rpx;
  padding: 24rpx 0 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
}

