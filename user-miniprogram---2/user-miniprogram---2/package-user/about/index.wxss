/* Unified commerce detail pass */
.container {
  background: var(--page-shell-bg);
}

.about-scroll {
  padding-left: 20rpx;
  padding-right: 20rpx;
  box-sizing: border-box;
}

.hero-card,
.info-card,
.story-card {
  border: 1rpx solid rgba(17, 17, 17, 0.06);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 12rpx 28rpx rgba(17, 17, 17, 0.05);
}

.hero-card,
.info-card,
.story-card {
  margin-left: 0;
  margin-right: 0;
}

.logo-wrap {
  background: linear-gradient(135deg, #111111 0%, #3b3d45 58%, #007AFF 100%);
  box-shadow: 0 16rpx 34rpx rgba(17, 17, 17, 0.16);
}

.hero-title,
.story-title,
.info-value {
  color: #111111;
}

.hero-version,
.info-label,
.footer-note,
.story-copy,
.hero-desc,
.story-kicker {
  color: #6b7080;
}

/* Readability pass */
.hero-title,
.story-title,
.info-value {
  font-size: 32rpx !important;
  line-height: 1.32 !important;
}

.hero-version,
.info-label,
.footer-note,
.story-copy,
.hero-desc,
.story-kicker {
  font-size: 24rpx !important;
  line-height: 1.55 !important;
}

.logo-wrap {
  width: 132rpx !important;
  height: 132rpx !important;
}
