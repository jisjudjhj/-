/* Unified commerce detail pass */
.chat-page {
  background: var(--page-shell-bg);
}

.chat-scroll {
  padding-left: 20rpx;
  padding-right: 20rpx;
  box-sizing: border-box;
}

.context-card,
.loading-wrap,
.empty-message {
  border: 1rpx solid rgba(17, 17, 17, 0.06);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 12rpx 28rpx rgba(17, 17, 17, 0.05);
}

.context-card {
  margin-left: 0;
  margin-right: 0;
}

.context-title,
.context-link-title,
.message-content {
  color: #111111;
}

.context-status,
.meta-chip,
.message-meta {
  color: #6b7080;
}

.meta-chip.is-active,
.meta-chip.is-queue,
.context-link-btn,
.tool-btn,
.send-btn.active {
  background: #eaf4ff;
  color: #007AFF;
}

.message-bubble {
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(17, 17, 17, 0.04);
}

.message-row.self .message-bubble {
  border-color: #111111;
  background: #111111;
}

.message-row.self .message-content,
.message-row.self .message-meta {
  color: #ffffff;
}

.composer-wrap {
  padding-left: 20rpx;
  padding-right: 20rpx;
  background: linear-gradient(180deg, rgba(246, 247, 249, 0), rgba(246, 247, 249, 0.92) 40%, rgba(246, 247, 249, 0.98) 100%);
  box-sizing: border-box;
}

.composer-row {
  border: 1rpx solid rgba(17, 17, 17, 0.06);
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(17, 17, 17, 0.06);
}

/* Readability pass */
.conversation-title,
.context-title,
.message-content {
  font-size: 28rpx !important;
  line-height: 1.52 !important;
}

.conversation-subtitle,
.context-copy,
.message-meta,
.meta-chip,
.tool-btn,
.context-link-btn {
  font-size: 24rpx !important;
  line-height: 1.45 !important;
}

.composer-input,
.send-btn {
  min-height: 72rpx !important;
  font-size: 26rpx !important;
}

