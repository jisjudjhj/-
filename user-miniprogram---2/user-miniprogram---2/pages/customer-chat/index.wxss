.chat-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(circle at 92% -8%, rgba(0, 122, 255, 0.08), transparent 34%),
    linear-gradient(180deg, #fbfcff 0%, #f6f7fb 48%, #f3f5f9 100%);
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  padding: 18rpx 20rpx 0;
}

.loading-wrap,
.context-card,
.message-bubble,
.composer-wrap,
.tool-btn,
.composer-input,
.send-btn {
  border-radius: 24rpx;
}

.loading-wrap {
  margin-top: 220rpx;
  text-align: center;
  color: #6f6759;
  font-size: 26rpx;
}

.context-card {
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.06);
  padding: 24rpx;
}

.context-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.context-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #181818;
  font-weight: 760;
}

.context-status {
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f4efe5;
  color: #6f6759;
  font-size: 20rpx;
  line-height: 38rpx;
  flex-shrink: 0;
}

.context-meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.meta-chip {
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f4efe5;
  color: #6f6759;
  font-size: 19rpx;
}

.meta-chip.is-active {
  background: rgba(212, 104, 72, 0.12);
  color: #c05f41;
}

.meta-chip.is-queue {
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  background: rgba(183, 134, 45, 0.14);
  color: #8f651c;
}

.context-link-row {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(18, 18, 18, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
}

.context-link-title {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: #181818;
}

.context-link-btn {
  flex-shrink: 0;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 21rpx;
}

.message-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.message-row {
  display: flex;
  justify-content: flex-start;
}

.message-row.self {
  justify-content: flex-end;
}

.message-row.system {
  justify-content: center;
}

.message-bubble {
  max-width: 82%;
  padding: 16rpx 18rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(19, 19, 19, 0.06);
}

.message-row.self .message-bubble {
  background: #111111;
}

.message-row.system .message-bubble {
  max-width: 90%;
  background: rgba(212, 104, 72, 0.1);
}

.message-meta {
  font-size: 18rpx;
  color: #8d8579;
}

.message-content {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.68;
  color: #181818;
}

.message-row.self .message-meta,
.message-row.self .message-content {
  color: rgba(255, 255, 255, 0.9);
}

.message-row.system .message-meta {
  color: #b15a3d;
}

.message-row.system .message-content {
  color: #8f442a;
}

.empty-message {
  margin-top: 80rpx;
  text-align: center;
  color: #6f6759;
  font-size: 24rpx;
}

.composer-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 -16rpx 34rpx rgba(19, 19, 19, 0.08);
  padding: 14rpx 18rpx calc(14rpx + env(safe-area-inset-bottom));
}

.composer-tools {
  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.tool-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  background: #111111;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.tool-btn.ghost {
  background: #f4efe5;
  color: #181818;
}

.tool-btn.disabled {
  max-width: calc(100vw - 80rpx);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: #f4efe5;
  color: #6f6759;
}

.composer-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.composer-input {
  flex: 1;
  height: 76rpx;
  background: #f4efe5;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #181818;
}

.send-btn {
  min-width: 114rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: #ddd7cb;
  color: #6f6759;
  font-size: 24rpx;
  font-weight: 700;
}

.send-btn.active {
  background: #111111;
  color: #ffffff;
}

