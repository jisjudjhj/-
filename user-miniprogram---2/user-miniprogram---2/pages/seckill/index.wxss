@import "../../app.wxss";

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fbf9f4 0%, #f4f0e7 52%, #f7f5ef 100%);
}

.hero-stage {
  margin: 122rpx 22rpx 0;
  position: relative;
}

.hero-overlay {
  position: absolute;
  inset: -14rpx;
  border-radius: 36rpx;
  background: rgba(17, 17, 17, 0.08);
  filter: blur(18rpx);
}

.hero-card {
  position: relative;
  border-radius: 34rpx;
  padding: 34rpx 30rpx 30rpx;
  background: #111111;
  box-shadow: 0 20rpx 48rpx rgba(19, 19, 19, 0.14);
  overflow: hidden;
}

.hero-eyebrow,
.hero-subtitle,
.hero-meta-chip,
.timeline-tip,
.timeline-week,
.timeline-countdown,
.group-desc,
.group-time,
.group-meta,
.group-divider,
.seckill-countdown,
.seckill-price-origin,
.seckill-sold,
.empty-desc,
.loading-text {
  color: rgba(255, 255, 255, 0.72);
}

.hero-eyebrow {
  font-size: 18rpx;
  letter-spacing: 4rpx;
}

.hero-title,
.timeline-title,
.timeline-date,
.timeline-time,
.timeline-name,
.group-title,
.group-countdown,
.seckill-title,
.empty-title,
.seckill-price-now {
  color: #181818;
}

.hero-title {
  display: block;
  margin-top: 14rpx;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.24;
  color: #ffffff;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.6;
}

.hero-meta-row {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hero-meta-chip,
.group-status-badge,
.seckill-status-badge,
.seckill-action,
.tab-item.active,
.timeline-card.selected {
  border-radius: 999rpx;
}

.hero-meta-chip {
  height: 44rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.12);
}

.tab-shell {
  position: sticky;
  top: 0;
  z-index: 8;
  padding-top: 8rpx;
  margin-top: 18rpx;
  margin-bottom: 4rpx;
  background: linear-gradient(180deg, rgba(247, 245, 239, 0.96) 0%, rgba(247, 245, 239, 0.84) 72%, rgba(247, 245, 239, 0) 100%);
}

.tab-bar {
  margin: 0 22rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 30rpx rgba(19, 19, 19, 0.08);
  display: flex;
  gap: 10rpx;
}

.tab-item {
  flex: 1;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #64748b;
}

.tab-item.active {
  background: #111111;
  color: #ffffff;
}

.tab-label {
  font-size: 25rpx;
  font-weight: 700;
  white-space: nowrap;
}

.tab-count {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 9rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #6f6759;
  background: #f1ebe0;
}

.tab-item.active .tab-count {
  color: #111111;
  background: #ffffff;
}

.timeline-panel {
  margin: 12rpx 22rpx 20rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 30rpx rgba(19, 19, 19, 0.08);
  padding: 20rpx 0 16rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.04);
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12rpx;
  padding: 0 20rpx 14rpx;
}

.timeline-title {
  font-size: 28rpx;
  font-weight: 800;
}

.timeline-tip,
.timeline-status,
.group-status-badge.upcoming,
.group-status-badge.history,
.seckill-status-badge.pending,
.seckill-status-badge.ended,
.seckill-action {
  color: #6f6759;
}

.timeline-tip {
  font-size: 21rpx;
}

.timeline-scroll {
  width: 100%;
  white-space: nowrap;
}

.timeline-list {
  position: relative;
  display: inline-flex;
  gap: 18rpx;
  align-items: flex-start;
  padding: 12rpx 20rpx;
}

.timeline-track {
  position: absolute;
  top: 66rpx;
  left: 44rpx;
  right: 44rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(18, 18, 18, 0.08);
}

.timeline-session {
  position: relative;
  width: 184rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.timeline-date {
  font-size: 24rpx;
  font-weight: 700;
}

.timeline-week {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9a9388;
}

.timeline-node-row {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-top: 10rpx;
}

.timeline-node {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  background: #d9d2c4;
}

.timeline-node.active {
  background: #111111;
}

.timeline-node.upcoming {
  background: #9a9388;
}

.timeline-card {
  margin-top: 12rpx;
  width: 100%;
  min-height: 130rpx;
  border-radius: 20rpx;
  padding: 14rpx 14rpx 18rpx;
  background: #f8f4eb;
}

.timeline-card.selected {
  background: #111111;
}

.timeline-card.selected .timeline-time,
.timeline-card.selected .timeline-status,
.timeline-card.selected .timeline-name,
.timeline-card.selected .timeline-countdown {
  color: #ffffff;
}

.list-wrap {
  padding: 0 22rpx 6rpx;
}

.loading-wrap,
.empty-wrap,
.activity-group {
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 34rpx rgba(19, 19, 19, 0.08);
}

.loading-wrap,
.empty-wrap {
  margin-top: 14rpx;
  border-radius: 24rpx;
  padding: 46rpx 24rpx;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  color: #6f6759;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6f6759;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.group-anchor {
  height: 400rpx;
  margin-top: -400rpx;
  visibility: hidden;
  pointer-events: none;
}

.activity-group {
  border-radius: 30rpx;
  padding: 26rpx 24rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.04);
}

.activity-group.selected {
  box-shadow: 0 18rpx 40rpx rgba(19, 19, 19, 0.1);
}

.group-header {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.group-cover {
  width: 150rpx;
  height: 150rpx;
  border-radius: 20rpx;
  background: #efe9de;
  flex-shrink: 0;
}

.group-info {
  flex: 1;
  min-width: 0;
}

.group-kicker {
  display: inline-block;
  color: #9a9388;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.group-title-row {
  display: flex;
  gap: 10rpx;
  align-items: center;
  flex-wrap: wrap;
}

.group-status-badge,
.seckill-status-badge,
.seckill-action {
  height: 38rpx;
  padding: 0 14rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  background: #f1ebe0;
}

.group-status-badge.active,
.seckill-status-badge.active,
.seckill-action.active {
  color: #ffffff;
  background: #111111;
}

.group-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.group-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.68;
  color: #6f6759;
}

.group-time,
.group-meta {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #6f6759;
}

.group-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.group-divider {
  opacity: 0.55;
}

.product-list {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.seckill-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.seckill-item product-card {
  display: block;
}

.seckill-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
  padding: 0 4rpx;
}

.seckill-card-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.seckill-origin,
.seckill-countdown,
.seckill-sold {
  color: #6f6759;
  font-size: 20rpx;
  line-height: 1.4;
}

.seckill-origin,
.seckill-countdown {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.seckill-foot-note {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  padding: 0 4rpx;
}

.seckill-note-divider {
  color: #b1aa9f;
  font-size: 18rpx;
}

.seckill-image {
  width: 100%;
  height: 286rpx;
  background: #efe9de;
}

.seckill-content {
  padding: 24rpx 22rpx;
}

.seckill-title {
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
}

.seckill-status-row,
.seckill-price-row,
.seckill-foot {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  justify-content: space-between;
}

.seckill-countdown,
.seckill-sold,
.seckill-price-origin {
  color: #6f6759;
  font-size: 22rpx;
}

.seckill-price-now {
  font-size: 42rpx;
  font-weight: 800;
}

.seckill-price-symbol {
  font-size: 22rpx;
  margin-right: 4rpx;
}

