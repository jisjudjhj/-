<scroll-view class="container" scroll-y bindscrolltolower="onReachBottom" lower-threshold="120" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
<custom-nav-bar title="{{pageTitle}}" showBack="{{true}}" backgroundColor="#ffffff" color="#111111"></custom-nav-bar>

  <view class="hero-panel">
    <view class="hero-eyebrow">搜索结果</view>
    <view class="hero-title" wx:if="{{keyword}}">“{{keyword}}” 的结果</view>
    <view class="hero-title" wx:elif="{{categoryName}}">分类 · {{categoryName}}</view>
    <view class="hero-title" wx:else>商品检索</view>
    <view class="hero-desc" wx:if="{{!loading && products.length}}">{{totalCount || products.length}} 件商品</view>
    <view class="hero-desc" wx:else>下拉可刷新，继续下滑可加载更多结果。</view>
  </view>

  <view class="search-tip" wx:if="{{keyword || categoryName}}">
    <text class="search-tip-text search-tip-chip" wx:if="{{keyword}}">关键词：{{keyword}}</text>
    <text class="search-tip-text search-tip-chip" wx:elif="{{categoryName}}">分类：{{categoryName}}</text>
    <text class="search-tip-count" wx:if="{{!loading && products.length}}">{{totalCount || products.length}} 件</text>
  </view>

  <scroll-view class="sort-scroll" scroll-x enable-flex show-scrollbar="{{false}}" wx:if="{{products.length}}">
    <view class="sort-bar">
      <view
        class="sort-item {{sortBy === item.value ? 'sort-item-active' : ''}}"
        wx:for="{{sortOptions}}"
        wx:key="value"
        bindtap="onSortChange"
        data-value="{{item.value}}"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">搜索中</view>
  </view>

  <view class="result-list" wx:elif="{{products.length}}">
    <view class="result-header">
      <text class="result-title">相关商品</text>
      <text class="result-subtitle">按相关度与热度综合排序</text>
    </view>
    <view class="result-grid">
      <view class="result-item-wrap" wx:for="{{products}}" wx:key="id">
        <product-card
          product="{{item}}"
          className="search-result-product"
          showSales="{{true}}"
          bind:click="goToDetail"
        ></product-card>
      </view>
    </view>
  </view>

  <block wx:elif="{{!loading}}">
    <view class="empty-wrap">
      <view class="empty-icon-wrap">
        <view class="empty-search-icon"></view>
      </view>
      <view class="empty-title">未找到相关商品</view>
      <view class="empty-desc" wx:if="{{keyword}}">没有找到和 “{{keyword}}” 相关的商品</view>
      <view class="empty-desc" wx:elif="{{categoryName}}">暂无商品</view>
      <view class="empty-desc" wx:elif="{{categoryId}}">暂无商品</view>
      <view class="empty-desc" wx:else>换个关键词再试试吧</view>
      <view class="empty-tips">
        <view class="tip-item">1. 检查输入的关键词是否有误</view>
        <view class="tip-item">2. 尝试使用更短或更通用的搜索词</view>
        <view class="tip-item">3. 换个分类</view>
      </view>
    </view>

    <view class="recommend-section" wx:if="{{recommendProducts.length}}">
      <view class="recommend-header">
        <view class="recommend-line"></view>
        <text class="recommend-title">没搜到也别急，先逛这些</text>
        <view class="recommend-line"></view>
      </view>
      <view class="recommend-grid">
        <view class="recommend-item-wrap" wx:for="{{recommendProducts}}" wx:key="id">
          <product-card
            product="{{item}}"
            className="search-result-recommend"
            showReason="{{true}}"
            showSales="{{true}}"
            bind:click="goToDetail"
          ></product-card>
        </view>
      </view>
    </view>
  </block>

  <view class="load-more" wx:if="{{!loading && products.length && hasMore}}">
    <view class="loading-text">加载更多...</view>
  </view>
  <view class="load-more" wx:if="{{!loading && products.length && !hasMore}}">
    <view class="no-more-text">已经展示全部结果了</view>
  </view>

  <view style="height: 40rpx;"></view>
</scroll-view>

