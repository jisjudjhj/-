.review-empty-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 19rpx;
  line-height: 1.6;
  color: #6b7080;
}

.review-footer-actions {
  margin-top: 14rpx;
}

.review-load-more {
  margin-top: 12rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #f2f4f7;
  color: #111111;
  font-size: 19rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.review-load-inline {
  margin-top: 12rpx;
}

/* Readability pass: product detail, reviews and bottom actions */
.product-title,
.detail-title,
.section-title,
.review-empty-title {
  font-size: 34rpx !important;
  line-height: 1.32 !important;
}

.product-subtitle,
.product-meta,
.spec-label,
.review-content,
.review-append-content,
.review-reply-content,
.review-empty-desc,
.review-date,
.review-append-label,
.review-reply-label {
  font-size: 24rpx !important;
  line-height: 1.58 !important;
}

.review-username {
  font-size: 26rpx !important;
}

.review-star {
  font-size: 24rpx !important;
}

.review-tag,
.review-helpful-btn,
.review-load-more {
  font-size: 22rpx !important;
}

.review-helpful-btn,
.review-load-more {
  min-height: 52rpx !important;
}

.action-btn,
.buy-btn,
.cart-btn,
.service-btn {
  min-height: 82rpx !important;
  font-size: 27rpx !important;
}

/* Readability pass: AI Q&A bottom sheet */
.ai-qa-popup {
  padding: 40rpx 30rpx calc(44rpx + env(safe-area-inset-bottom)) !important;
  max-height: 78vh !important;
  box-sizing: border-box;
}

.ai-qa-title {
  padding-right: 64rpx;
  font-size: 34rpx !important;
  line-height: 1.35 !important;
  font-weight: 800 !important;
  color: #111827 !important;
}

.ai-qa-quick-tags {
  margin-top: 24rpx !important;
  gap: 14rpx !important;
}

.ai-qa-tag {
  min-height: 58rpx !important;
  padding: 0 22rpx !important;
  border-radius: 18rpx !important;
  font-size: 24rpx !important;
  font-weight: 700 !important;
}

.ai-qa-input-row {
  margin-top: 24rpx !important;
  gap: 14rpx !important;
}

.ai-qa-input {
  height: 88rpx !important;
  padding: 0 26rpx !important;
  border-radius: 24rpx !important;
  font-size: 27rpx !important;
}

.ai-qa-send {
  min-width: 116rpx !important;
  height: 88rpx !important;
  border-radius: 24rpx !important;
  font-size: 26rpx !important;
  font-weight: 760 !important;
}

.ai-qa-answer {
  margin-top: 26rpx !important;
  padding: 26rpx 24rpx !important;
  border-radius: 24rpx !important;
  max-height: 42vh !important;
  overflow-y: auto !important;
}

.ai-qa-answer-badge {
  height: 40rpx !important;
  padding: 0 16rpx !important;
  font-size: 22rpx !important;
  font-weight: 760 !important;
}

.ai-qa-answer-text {
  display: block !important;
  margin-top: 18rpx !important;
  font-size: 28rpx !important;
  line-height: 1.78 !important;
  color: #1f2937 !important;
}

/* Product detail segmented navigation */
.commerce-tabs {
  position: sticky;
  top: 0;
  z-index: 20;
  margin-bottom: 0 !important;
  padding: 8rpx !important;
  border-radius: 22rpx !important;
  background: #ffffff !important;
  border: 1rpx solid rgba(17, 17, 17, 0.08) !important;
  box-shadow: 0 10rpx 24rpx rgba(17, 17, 17, 0.06) !important;
}

.commerce-tab {
  height: 58rpx !important;
  border-radius: 16rpx !important;
  background: #f6f7f9 !important;
  color: #6b7280 !important;
  font-size: 22rpx !important;
  font-weight: 650;
}

.commerce-tab-active {
  background: #eaf4ff !important;
  color: #007aff !important;
}

.commerce-tab-divider {
  height: 18rpx;
}

.commerce-content {
  min-height: 560rpx;
}

