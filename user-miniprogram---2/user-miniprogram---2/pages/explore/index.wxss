/* Feed-style recommendation layout (avoid waterfall duplication) */
.recommend-intro {
  margin: 2rpx 0 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #f7f8fb;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  color: #6e6e73;
  font-size: 22rpx;
  line-height: 1.5;
}

.feed-skeleton {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.skeleton-feature,
.skeleton-row {
  border-radius: 20rpx;
  background: linear-gradient(90deg, #f2f3f6 0%, #eceef3 50%, #f2f3f6 100%);
  background-size: 220% 100%;
  animation: skeleton-slide 1.2s linear infinite;
}

.skeleton-feature {
  height: 320rpx;
}

.skeleton-row {
  height: 168rpx;
}

.featured-card {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
  min-height: 320rpx;
  background: #f3f4f8;
}

.featured-image {
  width: 100%;
  height: 320rpx;
  display: block;
}

.featured-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 180rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(17, 17, 17, 0.72) 100%);
}

.featured-meta {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 16rpx;
  color: #ffffff;
}

.featured-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 66rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 18rpx;
  margin-bottom: 10rpx;
}

.featured-title {
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.35;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}

.featured-bottom {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.featured-price {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1;
}

.featured-sales {
  font-size: 20rpx;
  opacity: 0.86;
}

.feed-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.feed-item {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  border-radius: 20rpx;
  background: #fafbff;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  overflow: hidden;
  position: relative;
}

.feed-image {
  width: 180rpx;
  height: 168rpx;
  flex-shrink: 0;
  background: #eceff4;
}

.feed-content {
  flex: 1;
  min-width: 0;
  padding: 16rpx 16rpx 16rpx 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.feed-title {
  color: #111111;
  font-size: 26rpx;
  font-weight: 560;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.feed-footer {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.feed-price {
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.feed-sales {
  color: #8a8f99;
  font-size: 20rpx;
}

.feed-chip {
  position: absolute;
  right: 14rpx;
  top: 12rpx;
  min-width: 58rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #fff2e8;
  color: #ff7a1a;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes skeleton-slide {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: -100% 0;
  }
}

