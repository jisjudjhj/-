.order-text,
.service-name {
  color: var(--text-primary);
}

.order-text {
  margin-top: 8rpx;
  font-size: 19rpx;
  font-weight: 600;
}

.badge,
.service-count-badge {
  position: absolute;
  top: -8rpx;
  right: 2rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 999rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 16rpx;
  font-weight: 700;
  text-align: center;
  padding: 0 8rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  z-index: 3;
}

.service-list {
  margin-top: 12rpx;
}

.service-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 120rpx;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

