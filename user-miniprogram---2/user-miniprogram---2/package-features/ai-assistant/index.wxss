.chat-scroll {
  padding-left: 20rpx;
  padding-right: 20rpx;
  box-sizing: border-box;
}

.welcome-card,
.snapshot-panel,
.prompt-card,
.clarify-card,
.input-bar {
  border: 1rpx solid rgba(17, 17, 17, 0.06);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 12rpx 28rpx rgba(17, 17, 17, 0.05);
}

.welcome-card,
.snapshot-panel {
  margin-left: 0;
  margin-right: 0;
}

.welcome-icon,
.ai-avatar {
  background: linear-gradient(135deg, #111111 0%, #3b3d45 58%, #007AFF 100%);
  color: #ffffff;
}

.welcome-kicker,
.welcome-status,
.snapshot-chip,
.strategy-pill,
.focus-point,
.intent-tag {
  background: #eaf4ff;
  color: #007AFF;
}

.welcome-title,
.snapshot-title,
.snapshot-detail-title,
.insight-title,
.prompt-title,
.clarify-title {
  color: #111111;
}

.welcome-desc,
.snapshot-sub,
.snapshot-brief,
.snapshot-detail-value,
.insight-detail,
.clarify-desc {
  color: #6b7080;
}

.quick-tag,
.action-chip,
.prompt-chip,
.clarify-chip {
  border: 1rpx solid rgba(17, 17, 17, 0.07);
  background: #f4f5f7;
  color: #404654;
}

.user-bubble {
  background: #111111;
  color: #ffffff;
}

.ai-bubble {
  border: 1rpx solid rgba(17, 17, 17, 0.06);
  background: #ffffff;
  color: #111111;
  box-shadow: 0 10rpx 24rpx rgba(17, 17, 17, 0.04);
}


.product-card-img {
  border-radius: 18rpx;
}

.product-card-price {
  color: #007AFF;
}

.product-card-btn,
.send-btn-active {
  background: #111111;
  color: #ffffff;
}

.input-bar-wrap {
  padding-left: 20rpx;
  padding-right: 20rpx;
  background: linear-gradient(180deg, rgba(246, 247, 249, 0), rgba(246, 247, 249, 0.92) 42%, rgba(246, 247, 249, 0.98) 100%);
  box-sizing: border-box;
}

.input-field {
  background: #f4f5f7;
}

/* Readability pass */
.hero-title,
.section-title,
.message-title,
.product-card-title {
  font-size: 31rpx !important;
  line-height: 1.34 !important;
}

.hero-sub,
.prompt-chip,
.message-text,
.message-meta,
.product-card-desc,
.product-card-btn,
.input-field {
  font-size: 24rpx !important;
  line-height: 1.5 !important;
}

.product-card-price {
  font-size: 34rpx !important;
}

.send-btn,
.send-btn-active {
  min-height: 72rpx !important;
  min-width: 72rpx !important;
}

/* Compact AI assistant copy: short answers first, less reading pressure */
.snapshot-brief,
.insight-detail,
.clarify-desc {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ai-bubble {
  font-size: 27rpx;
  line-height: 1.58;
}

.focus-points,
.intent-tags,
.prompt-actions,
.clarify-actions {
  gap: 10rpx;
}

.prompt-card,
.clarify-card {
  padding: 18rpx 20rpx;
}

.prompt-title,
.clarify-title {
  font-size: 25rpx;
}

/* Pure white assistant theme */
.container,
.chat-scroll {
  background: #ffffff !important;
}

.welcome-card,
.snapshot-panel,
.prompt-card,
.clarify-card,
.input-bar,
.ai-bubble,
.product-card {
  background: #ffffff !important;
  border: 1rpx solid #eeeeee !important;
  box-shadow: none !important;
}

.input-bar-wrap {
  background: #ffffff !important;
  border-top: 1rpx solid #eeeeee;
}

.input-field,
.quick-tag,
.action-chip,
.prompt-chip,
.clarify-chip,
.focus-point,
.intent-tag,
.strategy-pill,
.snapshot-chip,
.welcome-kicker,
.welcome-status {
  background: #ffffff !important;
  border: 1rpx solid #eeeeee !important;
  color: #333333 !important;
}

.welcome-icon,
.ai-avatar,
.send-btn-active {
  background: #111111 !important;
  color: #ffffff !important;
}

.send-btn {
  background: #f7f7f7 !important;
}

.welcome-title,
.snapshot-title,
.snapshot-detail-title,
.insight-title,
.prompt-title,
.clarify-title,
.ai-bubble,
.user-bubble {
  color: #111111 !important;
}

.user-bubble {
  background: #f7f7f7 !important;
  border: 1rpx solid #eeeeee !important;
}

