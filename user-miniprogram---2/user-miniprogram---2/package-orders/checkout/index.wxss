  line-height: 1.46 !important;
}

.section-badge,
.warning-tag,
.coupon-tag {
  min-height: 40rpx !important;
  font-size: 21rpx !important;
}

.payment-icon {
  width: 52rpx !important;
  height: 52rpx !important;
}

.goods-price,
.coupon-discount,
.summary-value,
.total-price,
.submit-price {
  font-size: 34rpx !important;
}

.submit-bar {
  min-height: 112rpx !important;
}

.submit-button,
.submit-btn {
