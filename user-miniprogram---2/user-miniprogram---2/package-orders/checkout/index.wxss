/* Unified commerce detail pass */
.pay-page {
  background: var(--page-shell-bg);
}

.section,
.coupon-picker,
.coupon-option,
.submit-bar {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(17, 17, 17, 0.06);
  box-shadow: 0 12rpx 28rpx rgba(17, 17, 17, 0.05);
}

.pay-scroll {
  padding-left: 20rpx;
  padding-right: 20rpx;
}

.section {
  margin-left: 0;
  margin-right: 0;
}

.warning-tag,
.section-badge,
.coupon-tag {
  background: #eaf4ff;
  color: #007AFF;
}

.section-title,
.goods-title,
.payment-name,
.coupon-name {
  color: #111111;
}

.section-tip,
.goods-meta,
.payment-balance,
.summary-label,
.submit-tip {
  color: #6b7080;
}

.payment-item-active,
.coupon-option.active {
  border-color: rgba(0, 122, 255, 0.22);
  background: #fff8fa;
}

.goods-price,
.coupon-discount,
.summary-row.discount .summary-value,
.total-price,
.submit-price,
.price-symbol {
  color: #007AFF;
}

.submit-wrap {
  padding-left: 20rpx;
  padding-right: 20rpx;
}

/* Readability pass: checkout flow */
.section-title,
.goods-title,
.payment-name,
.coupon-name {
  font-size: 30rpx !important;
  line-height: 1.36 !important;
}

.section-tip,
.goods-meta,
.payment-balance,
.summary-label,
.submit-tip,
.coupon-option-meta,
.coupon-option-name,
.smart-guide-apply {
