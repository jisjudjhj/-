.review-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 92% -4%, rgba(255, 91, 114, 0.08), transparent 28%),
    linear-gradient(180deg, #fbfcff 0%, #f6f7fb 48%, #f1f4f8 100%);
}

.review-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding: 112rpx 20rpx 0;
}

.hero-block,
.panel,
.product-card,
.disabled-state {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(22, 24, 35, 0.05);
  box-shadow: 0 14rpx 32rpx rgba(15, 23, 42, 0.05);
}

.hero-block {
  padding: 26rpx 24rpx;
}

.hero-kicker {
  display: block;
  font-size: 18rpx;
  letter-spacing: 1.5rpx;
  color: #7a8291;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 760;
  color: #111111;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #6b7080;
}

.product-card {
  margin-top: 16rpx;
  padding: 18rpx;
  display: flex;
  gap: 16rpx;
}

.product-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  background: #f3f5f9;
  flex-shrink: 0;
}

.product-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa3b2;
  font-size: 18rpx;
}

.product-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.product-name {
  font-size: 26rpx;
  line-height: 1.45;
  color: #111111;
  font-weight: 700;
}

.product-meta,
.product-price {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #6b7080;
}

.product-price {
  color: #007AFF;
  font-weight: 700;
}

.panel,
.disabled-state {
  margin-top: 16rpx;
  padding: 22rpx 20rpx;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.panel-title {
  font-size: 24rpx;
  color: #111111;
  font-weight: 700;
}

.panel-meta {
  font-size: 18rpx;
  color: #7a8291;
}

.star-row {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}

.star-item {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #f3f5f9;
  color: #b7bdc9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
}

.star-item-active {
  background: #eaf4ff;
  color: #007AFF;
}

.rating-copy {
  margin-top: 14rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #6b7080;
}

.review-input {
  width: 100%;
  min-height: 220rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f5f7fb;
  font-size: 22rpx;
  line-height: 1.6;
  color: #111111;
}

.tag-grid {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-pill {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #f3f5f9;
  color: #5f6777;
  font-size: 20rpx;
}

.tag-pill-active {
  background: #111111;
  color: #ffffff;
}

.image-grid {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.image-card,
.image-picker {
  width: 206rpx;
  height: 206rpx;
  border-radius: 22rpx;
  overflow: hidden;
  position: relative;
  background: #f3f5f9;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  min-width: 68rpx;
  height: 42rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.68);
  color: #ffffff;
  font-size: 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.image-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7a8291;
}

.image-picker-plus {
  font-size: 42rpx;
  line-height: 1;
}

.image-picker-copy {
  margin-top: 12rpx;
  font-size: 20rpx;
}

.disabled-title {
  display: block;
  font-size: 24rpx;
  color: #111111;
  font-weight: 700;
}

.disabled-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #6b7080;
}

.loading-wrap {
  padding: 80rpx 0 0;
  text-align: center;
  color: #7a8291;
  font-size: 21rpx;
}

.submit-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 0;
  padding: 14rpx 0 calc(14rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(241, 244, 248, 0) 0%, rgba(241, 244, 248, 0.94) 38%, rgba(241, 244, 248, 1) 100%);
}

.submit-tip {
  display: block;
  margin: 0 8rpx 10rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: #7a8291;
  text-align: center;
}

/* Readability pass */
.section-title,
.goods-title,
.field-title {
  font-size: 31rpx !important;
  line-height: 1.34 !important;
}

.goods-meta,
.field-tip,
.review-textarea,
.upload-tip,
.loading-wrap,
.submit-tip {
  font-size: 25rpx !important;
  line-height: 1.5 !important;
}

.rating-star,
.star-item {
  font-size: 44rpx !important;
}

.submit-btn,
.submit-bar button {
  min-height: 82rpx !important;
  font-size: 27rpx !important;
}

