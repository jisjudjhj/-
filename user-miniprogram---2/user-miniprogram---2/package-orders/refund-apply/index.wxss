.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f7;
}

.content-scroll {
  flex: 1;
  height: 0;
  padding: 8rpx 24rpx 0;
  box-sizing: border-box;
}

.section,
.tips-card,
.service-card,
.state-wrap {
  margin-top: 14rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid var(--border-light);
  box-shadow: 0 8rpx 22rpx rgba(17, 17, 17, 0.03);
}

.state-wrap {
  padding: 152rpx 0;
  text-align: center;
}

.state-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.section {
  padding: 24rpx 22rpx;
}

.section-title,
.tips-title,
.service-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.order-meta,
.reason-options {
  margin-top: 16rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.meta-row:last-child {
  margin-bottom: 0;
}

.meta-label,
.goods-qty,
.reason-count {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.meta-value {
  font-size: 22rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.meta-value.price,
.goods-price {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--danger-color);
}

.goods-item {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.goods-item:first-of-type {
  margin-top: 16rpx;
}

.goods-img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 18rpx;
  background: #f4f7fb;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.goods-title {
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 600;
  color: var(--text-primary);
}

.goods-bottom {
  margin-top: auto;
  display: flex;
  align-items: baseline;
}

.goods-qty {
  margin-left: auto;
}

.reason-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.reason-chip {
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  border: 1rpx solid transparent;
  color: var(--text-secondary);
  font-size: 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.reason-chip.active {
  background: #eaf3ff;
  border-color: rgba(0, 122, 255, 0.1);
  color: var(--accent-color);
}

.reason-textarea {
  width: 100%;
  height: 160rpx;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f7f7fa;
  border: 1rpx solid rgba(60, 60, 67, 0.12);
  font-size: 24rpx;
  line-height: 1.66;
  color: var(--text-primary);
  box-sizing: border-box;
}

.reason-count {
  margin-top: 10rpx;
  text-align: right;
}

.tips-card {
  padding: 22rpx;
}

.service-card {
  padding: 22rpx;
}

.service-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--text-secondary);
}

.service-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.service-action {
  height: 72rpx;
  border-radius: 18rpx;
  background: #eaf4ff;
  color: #007AFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.service-action--dark {
  background: #111827;
  color: #ffffff;
}

.tips-text {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.66;
  color: var(--text-secondary);
}

.bottom-space {
  height: 180rpx;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 0 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 245, 247, 0), rgba(245, 245, 247, 0.9) 45%, rgba(245, 245, 247, 0.98) 100%);
}

/* Unified commerce detail pass */
.container {
  background: var(--page-shell-bg);
}

.content-scroll {
  padding-left: 20rpx;
  padding-right: 20rpx;
  box-sizing: border-box;
}

.state-wrap,
.section,
.service-card,
.tips-card {
  border: 1rpx solid rgba(17, 17, 17, 0.06);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 12rpx 28rpx rgba(17, 17, 17, 0.05);
}

.section,
.service-card,
.tips-card {
  margin-left: 0;
  margin-right: 0;
}

.section-title,
.goods-title,
.meta-value,
.tips-title,
.service-title {
  color: #111111;
}

.meta-label,
.goods-spec,
.tips-text,
.service-desc,
.field-tip,
.reason-count {
  color: #6b7080;
}

.meta-value.price,
.goods-price,
.refund-price {
  color: #007AFF;
}

.reason-chip {
  border-color: rgba(17, 17, 17, 0.08);
  background: #f4f5f7;
  color: #404654;
}

.reason-chip.active {
  border-color: rgba(0, 122, 255, 0.24);
  background: #eaf4ff;
  color: #007AFF;
}

.reason-textarea {
  border-color: rgba(17, 17, 17, 0.08);
  background: #f4f5f7;
}

.submit-bar {
  padding-left: 20rpx;
  padding-right: 20rpx;
  background: linear-gradient(180deg, rgba(246, 247, 249, 0), rgba(246, 247, 249, 0.92) 45%, rgba(246, 247, 249, 0.98) 100%);
  box-sizing: border-box;
}

/* Readability pass */
.section-title,
.goods-title,
.form-title {
  font-size: 31rpx !important;
  line-height: 1.34 !important;
}

.meta-label,
.meta-value,
.goods-meta,
.reason-chip,
.reason-textarea,
.form-tip {
  font-size: 25rpx !important;
  line-height: 1.5 !important;
}

.meta-value.price,
.goods-price,
.refund-price {
  font-size: 36rpx !important;
}

.submit-btn,
.submit-bar button {
  min-height: 82rpx !important;
  font-size: 27rpx !important;
}

