.custom-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 40rpx;
  text-align: center;
  border-radius: 999rpx;
  font-weight: 700;
  transition: all 0.24s ease;
  margin: 0;
  overflow: hidden;
  border: 1rpx solid transparent;
}

.custom-btn::after {
  border: none;
}

.custom-btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.custom-btn-primary {
  color: #ffffff;
  background: #121317;
  box-shadow: 0 12rpx 28rpx rgba(18, 22, 30, 0.14);
}

.custom-btn-secondary {
  background: #ffffff;
  color: #171a20;
  border-color: rgba(20, 24, 31, 0.08);
  box-shadow: 0 10rpx 24rpx rgba(18, 22, 30, 0.06);
}

.custom-btn-accent {
  background: #ffe8ef;
  color: #007AFF;
  box-shadow: 0 10rpx 24rpx rgba(0, 122, 255, 0.08);
}

.custom-btn-text {
  background-color: transparent;
  color: #171a20;
  padding: 0;
  border-color: transparent;
  box-shadow: none;
}

.custom-btn-large {
  height: 104rpx;
  font-size: 32rpx;
  padding: 0 52rpx;
}

.custom-btn-normal {
  height: 88rpx;
  font-size: 28rpx;
}

.custom-btn-small {
  height: 64rpx;
  font-size: 24rpx;
  padding: 0 28rpx;
}

.custom-btn-round {
  border-radius: 999rpx;
}

.custom-btn-block {
  display: flex;
  width: 100%;
}

.custom-btn-disabled {
  opacity: 0.5;
  cursor: not-allowed;
  box-shadow: none !important;
}

.custom-btn-hover {
  transform: scale(0.97);
}

/* iOS minimal white refinement */
.custom-btn {
  border-radius: 999rpx;
  font-weight: 600;
}

.custom-btn-primary {
  color: #ffffff;
  background: #007AFF;
  border-color: #007AFF;
  box-shadow: none;
}

.custom-btn-secondary {
  background: #f5f5f7;
  color: #111111;
  border-color: rgba(60, 60, 67, 0.12);
  box-shadow: none;
}

.custom-btn-accent {
  background: #ffe8ef;
  color: #007AFF;
  border-color: rgba(0, 122, 255, 0.16);
  box-shadow: none;
}

.custom-btn-text {
  color: #007AFF;
}

.custom-btn-disabled {
  opacity: 0.45;
}

/* Official iOS control language */
.custom-btn {
  min-height: 88rpx;
  border-radius: 999rpx;
  font-weight: 600;
  transition: opacity 0.16s ease, transform 0.16s ease, background-color 0.18s ease;
}

.custom-btn-primary {
  color: #ffffff;
  background: var(--accent-color);
  border-color: var(--accent-color);
  box-shadow: none;
}

.custom-btn-secondary {
  background: var(--surface-soft);
  color: var(--text-primary);
  border-color: var(--border-color);
  box-shadow: none;
}

.custom-btn-accent {
  background: var(--accent-soft);
  color: var(--accent-color);
  border-color: rgba(0, 122, 255, 0.16);
  box-shadow: none;
}

.custom-btn-text {
  color: var(--accent-color);
}
