}

.product-listing .product-img-wrap {
  width: 188rpx !important;
  height: 188rpx !important;
  flex: 0 0 188rpx !important;
  padding-top: 0 !important;
  border-radius: 22rpx !important;
  background: #f1f3f6 !important;
}

.product-listing .product-img {
  transform: none !important;
}

.product-listing .product-badge {
  top: 12rpx !important;
  left: 12rpx !important;
  min-height: 34rpx !important;
  height: 34rpx !important;
  padding: 0 10rpx !important;
  font-size: 18rpx !important;
  line-height: 34rpx !important;
  border-radius: 999rpx !important;
}

.product-listing .product-info {
  flex: 1 !important;
  min-width: 0 !important;
  min-height: 188rpx !important;
  padding: 0 0 0 22rpx !important;
  margin-top: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
}

.product-listing .product-title-wrap {
  min-height: 0 !important;
}

.product-listing .product-name {
  min-height: 0 !important;
  max-height: 74rpx !important;
  margin-bottom: 8rpx !important;
  font-size: 28rpx !important;
  line-height: 1.34 !important;
  font-weight: 740 !important;
  -webkit-line-clamp: 2 !important;
}

.product-listing .product-meta-line,
.product-listing .product-sales {
  min-height: 0 !important;
  font-size: 22rpx !important;
  line-height: 1.38 !important;
}

.product-listing .product-reason {
  min-height: 0 !important;
  max-height: 62rpx !important;
  font-size: 22rpx !important;
  line-height: 1.4 !important;
  -webkit-line-clamp: 2 !important;
}

.product-listing .product-reason-tags {
  margin-top: 8rpx !important;
  height: 38rpx !important;
  max-height: 38rpx !important;
}

.product-listing .product-reason-tag,
.product-listing .product-source-chip,
.product-listing .product-explain-btn {
  min-height: 34rpx !important;
  height: 34rpx !important;
  padding: 0 10rpx !important;
  font-size: 18rpx !important;
  line-height: 34rpx !important;
}

.product-listing .product-signal-row {
  margin-top: 8rpx !important;
  min-height: 34rpx !important;
}

.product-listing .product-bottom {
  align-items: center !important;
  gap: 12rpx !important;
  margin-top: 10rpx !important;
  padding-top: 0 !important;
  border-top: 0 !important;
}

.product-listing .product-price-wrap {
  min-height: 0 !important;
}

.product-listing .price-sign {
  font-size: 20rpx !important;
}

.product-listing .price-num {
  font-size: 36rpx !important;
}

.product-listing .product-add-btn,
.product-listing .product-dislike-btn {
  width: 52rpx !important;
  height: 52rpx !important;
  border-radius: 26rpx !important;
}
