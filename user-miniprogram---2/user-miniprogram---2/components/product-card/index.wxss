/* Layout audit: stable two-column card geometry */
.product-card {
  border-radius: 18rpx;
  box-shadow: none;
}

.product-img-wrap {
  padding-top: 100%;
}

.product-img-wrap::after {
  display: none;
}

.product-info {
  min-height: 188rpx;
  padding: 14rpx 14rpx 16rpx;
}

.product-title-wrap {
  min-height: 86rpx;
}

.product-name {
  min-height: 62rpx;
  font-size: 23rpx;
  line-height: 1.36;
  letter-spacing: 0;
}

.product-meta-line,
.product-reason {
  font-size: 17rpx;
  line-height: 1.35;
}

.price-num {
  font-size: 30rpx;
}

.product-sales {
  max-width: 120rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* Readability pass: larger product text and actions without changing grid */
.product-info {
  min-height: 216rpx !important;
  padding: 18rpx 16rpx 18rpx !important;
}

.product-title-wrap {
  min-height: 112rpx !important;
}

.product-name {
  min-height: 70rpx !important;
  font-size: 26rpx !important;
  line-height: 1.4 !important;
  font-weight: 730 !important;
}

.product-meta-line,
.product-reason,
.product-sales {
  font-size: 21rpx !important;
  line-height: 1.42 !important;
}

.product-reason {
  min-height: 58rpx !important;
  max-height: 58rpx !important;
}

.product-reason-tag,
.product-badge,
.product-signal-chip {
  min-height: 38rpx !important;
  padding: 0 12rpx !important;
  font-size: 20rpx !important;
  line-height: 38rpx !important;
}

.price-sign {
  font-size: 20rpx !important;
}

.price-num {
  font-size: 36rpx !important;
}

.product-dislike-btn,
.product-add-btn {
  width: 54rpx !important;
  height: 54rpx !important;
  border-radius: 27rpx !important;
}

.product-add-icon,
.product-dislike-icon {
  width: 28rpx !important;
  height: 28rpx !important;
}

/* Final product-card contract: keep one effective geometry after legacy overrides. */
.product-card {
  min-height: 520rpx !important;
  border-radius: 24rpx !important;
  border-color: var(--border-color) !important;
  background: #ffffff !important;
  box-shadow: var(--shadow-sm) !important;
}

.product-info {
  min-height: 232rpx !important;
  padding: 18rpx 16rpx 18rpx !important;
}

.product-title-wrap {
  min-height: 126rpx !important;
}

.product-name {
  min-height: 72rpx !important;
  max-height: 108rpx !important;
  -webkit-line-clamp: 3 !important;
}

.product-reason {
  min-height: 60rpx !important;
  max-height: 90rpx !important;
  -webkit-line-clamp: 3 !important;
}

.product-price {
  color: var(--danger-color) !important;
}

/* Cardless commerce listing: shared product surfaces become shelf rows. */
