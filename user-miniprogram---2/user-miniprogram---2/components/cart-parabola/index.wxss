.parabola-wrap {
  position: fixed;
  z-index: 9999;
  width: 80rpx;
  height: 80rpx;
  margin-left: -40rpx;
  margin-top: -40rpx;
  pointer-events: none;
}

.parabola-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  border: 4rpx solid #fff;
  opacity: 1;
  transition: opacity 0.2s ease;
}

.parabola-img {
  width: 100%;
  height: 100%;
  display: block;
}