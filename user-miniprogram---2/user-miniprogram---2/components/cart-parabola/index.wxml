<view class="parabola-wrap" wx:if="{{show}}" style="left: {{startX}}px; top: {{startY}}px; transform: translate3d(0, {{translateY}}px, 0); transition: transform {{duration}}ms cubic-bezier(0.3, -0.3, 1, 1);">
  <view class="parabola-inner" style="transform: translate3d({{translateX}}px, 0, 0); transition: transform {{duration}}ms linear;">
    <image class="parabola-img" src="{{image}}" mode="aspectFill"></image>
  </view>
</view>