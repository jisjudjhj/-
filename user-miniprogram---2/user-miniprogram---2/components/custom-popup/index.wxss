.custom-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  visibility: hidden;
  pointer-events: none;
  transition: visibility 0.3s;
  z-index: 1000;
}

.custom-popup-show {
  visibility: visible;
  pointer-events: auto;
}

.custom-popup-mask {
  position: absolute;
  inset: 0;
  background-color: rgba(17, 17, 17, 0.28);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.custom-popup-show .custom-popup-mask {
  opacity: 1;
}

.custom-popup-content {
  position: absolute;
  background-color: #f7f5ef;
  transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow: 0 24rpx 60rpx rgba(19, 19, 19, 0.12);
}

.custom-popup-bottom {
  bottom: 0;
  left: 0;
  width: 100%;
  transform: translateY(100%);
  padding-bottom: env(safe-area-inset-bottom);
}

.custom-popup-show .custom-popup-bottom {
  transform: translateY(0);
}

.custom-popup-bottom.custom-popup-round {
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
}

.custom-popup-top {
  top: 0;
  left: 0;
  width: 100%;
  transform: translateY(-100%);
}

.custom-popup-show .custom-popup-top {
  transform: translateY(0);
}

.custom-popup-top.custom-popup-round {
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

.custom-popup-center {
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.94);
  opacity: 0;
  transition: all 0.32s cubic-bezier(0.22, 1, 0.36, 1);
}

.custom-popup-show .custom-popup-center {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
}

.custom-popup-center.custom-popup-round {
  border-radius: 40rpx;
}

.custom-popup-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  background: rgba(255, 255, 255, 0.78);
  border-radius: 50%;
}

.custom-popup-close:active {
  transform: scale(0.92);
}

.close-icon {
  width: 24rpx;
  height: 24rpx;
  position: relative;
}

.close-icon::before,
.close-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 3rpx;
  background-color: #111111;
  border-radius: 2rpx;
}

.close-icon::before {
  transform: translateY(-50%) rotate(45deg);
}

.close-icon::after {
  transform: translateY(-50%) rotate(-45deg);
}

/* Official iOS sheet language */
.custom-popup-mask {
  background-color: rgba(17, 17, 17, 0.22);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.custom-popup-content {
  background-color: #ffffff;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.08);
}

.custom-popup-bottom.custom-popup-round {
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
}

.custom-popup-close {
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}
