.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 999;
  transition: all 0.34s cubic-bezier(0.22, 1, 0.36, 1);
}

.nav-bar-scrolled {
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 12rpx 34rpx rgba(15, 23, 42, 0.06);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
}

.nav-bar-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.nav-bar-left {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(22, 24, 35, 0.06);
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.05);
}

.back-icon {
  width: 20rpx;
  height: 20rpx;
  border-top: 4rpx solid #111111;
  border-left: 4rpx solid #111111;
  transform: rotate(-45deg);
  border-radius: 2rpx;
  transition: border-color 0.3s ease;
}

.nav-bar-title {
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  max-width: 54%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  letter-spacing: 0;
  transition: opacity 0.3s ease, color 0.3s ease;
}

.nav-bar-right {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 80rpx;
  min-height: 48rpx;
}

.nav-bar-placeholder {
  width: 100%;
}

/* Unified commerce direction */
.nav-bar-scrolled {
  background: rgba(245, 246, 248, 0.84);
  box-shadow: 0 10rpx 24rpx rgba(17, 17, 17, 0.05);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}

.nav-bar-left {
  left: 20rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(17, 17, 17, 0.05);
  box-shadow: 0 8rpx 18rpx rgba(17, 17, 17, 0.05);
}

.nav-bar-title {
  max-width: 58%;
  font-size: 28rpx;
  font-weight: 760;
  color: #111111;
}

.nav-bar-right {
  right: 20rpx;
}

/* Official iOS navigation */
.nav-bar {
  z-index: 9999;
}

.nav-bar-scrolled {
  background: rgba(255, 255, 255, 0.94);
  border-bottom: 1rpx solid var(--border-color);
  box-shadow: none;
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
}

.nav-bar-left {
  background: var(--surface-soft);
  border-color: var(--border-color);
  box-shadow: none;
}

.nav-bar-title {
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 650;
  letter-spacing: 0;
}

/* Make the back affordance visible on pale headers */
.nav-bar-left {
  width: 72rpx !important;
  height: 72rpx !important;
  background: #ffffff !important;
  border: 1.5rpx solid rgba(17, 17, 17, 0.16) !important;
  box-shadow: 0 8rpx 22rpx rgba(17, 17, 17, 0.12) !important;
}

.back-icon {
  width: 24rpx;
  height: 24rpx;
  border-top-width: 5rpx;
  border-left-width: 5rpx;
}
